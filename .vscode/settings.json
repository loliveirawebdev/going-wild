{
  "[dart]": {
    "editor.rulers": [ 140 ],
    "editor.formatOnSave": true,
    "editor.selectionHighlight": false,
    "editor.suggestSelection": "first",
    "editor.wordBasedSuggestions": "off",
    "editor.tabCompletion": "onlySnippets",
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.codeActionsOnSave": { "source.fixAll": "explicit", "source.organizeImports": "explicit" },
  },

  "dart.lineLength": 140,
  "editor.formatOnSave": true,
  "json.format.keepLines": true,
  "dart.previewFlutterUiGuides": true,
  "files.exclude": { "**/.dart_tool": true, "**/build": true },
  "search.exclude": { "**/.dart_tool": true, "**/build": true },
  "[yaml]": { "editor.formatOnSave": true, "editor.insertSpaces": true, "editor.tabSize": 2 },
  "[json]": { "editor.defaultFormatter": "vscode.json-language-features", "editor.formatOnSave": true },
  "[jsonc]": { "editor.defaultFormatter": "vscode.json-language-features", "editor.formatOnSave": true },
}
